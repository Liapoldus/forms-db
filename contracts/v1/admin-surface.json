{
  "version": 1,
  "plugin": "forms-db",
  "requiredCapabilities": ["forms.list", "forms.delete"],
  "pages": [
    {
      "id": "submissions",
      "title": "Form submissions",
      "capability": "forms.list",
      "query": {
        "id": "query",
        "capability": "forms.list",
        "inputSchema": {
          "type": "object",
          "properties": {
            "site": { "type": "string", "minLength": 1 },
            "schemaName": { "type": "string", "minLength": 1 },
            "cursor": { "type": "string", "maxLength": 4096 },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
            "filter": {
              "type": "object",
              "properties": {
                "field": { "type": "string", "minLength": 1 },
                "equals": true
              },
              "required": ["field", "equals"],
              "additionalProperties": false
            }
          },
          "required": ["site", "schemaName"],
          "additionalProperties": false
        }
      },
      "permissions": ["plugins.forms-db.read", "plugins.forms-db.write"],
      "sections": [
        {
          "id": "filters",
          "kind": "form",
          "fields": [
            { "key": "site", "type": "select", "required": true },
            { "key": "schemaName", "type": "select", "required": true },
            { "key": "field", "type": "string" },
            { "key": "equals", "type": "string" }
          ]
        },
        {
          "id": "records",
          "kind": "table",
          "dataCapability": "forms.list",
          "columns": ["id", "site", "schemaName", "createdAt", "data"],
          "actions": [
            {
              "id": "delete",
              "title": "Delete submission",
              "capability": "forms.delete",
              "confirmation": "Delete this submission permanently?",
              "dangerous": true,
              "inputSchema": {
                "type": "object",
                "properties": {
                  "site": { "type": "string", "minLength": 1 },
                  "schemaName": { "type": "string", "minLength": 1 },
                  "id": { "type": "string", "minLength": 1 }
                },
                "required": ["site", "schemaName", "id"],
                "additionalProperties": false
              },
              "rowInput": { "site": "site", "schemaName": "schemaName", "id": "id" }
            }
          ]
        }
      ]
    }
  ]
}
