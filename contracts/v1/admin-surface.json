{
  "pages": [
    {
      "capability": "forms.list",
      "id": "submissions",
      "permissions": [
        "plugins.forms-db.read",
        "plugins.forms-db.write"
      ],
      "query": {
        "capability": "forms.list",
        "id": "query",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "cursor": {
              "maxLength": 4096,
              "type": "string"
            },
            "filter": {
              "additionalProperties": false,
              "properties": {
                "equals": true,
                "field": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "field",
                "equals"
              ],
              "type": "object"
            },
            "limit": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "schemaName": {
              "minLength": 1,
              "type": "string"
            },
            "site": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "site",
            "schemaName"
          ],
          "type": "object"
        }
      },
      "sections": [
        {
          "fields": [
            {
              "key": "site",
              "required": true,
              "type": "select"
            },
            {
              "key": "schemaName",
              "required": true,
              "type": "select"
            },
            {
              "key": "field",
              "type": "string"
            },
            {
              "key": "equals",
              "type": "string"
            }
          ],
          "id": "filters",
          "kind": "form"
        },
        {
          "actions": [
            {
              "capability": "forms.delete",
              "confirmation": "Delete this submission permanently?",
              "dangerous": true,
              "id": "delete",
              "inputSchema": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "schemaName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "site": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "site",
                  "schemaName",
                  "id"
                ],
                "type": "object"
              },
              "rowInput": {
                "id": "id",
                "schemaName": "schemaName",
                "site": "site"
              },
              "title": "Delete submission"
            }
          ],
          "columns": [
            "id",
            "site",
            "schemaName",
            "createdAt",
            "data"
          ],
          "dataCapability": "forms.list",
          "id": "records",
          "kind": "table"
        }
      ],
      "title": "Form submissions"
    }
  ],
  "plugin": "forms-db",
  "requiredCapabilities": [
    "forms.list",
    "forms.delete"
  ],
  "version": 1
}
