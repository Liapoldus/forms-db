{
  "$id": "https://github.com/Liapoldus/forms-db/contracts/v1/list-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Запрос страницы отправок. Cursor непрозрачен для вызывающей стороны; его формат и механизм защиты здесь не задаются.",
  "properties": {
    "cursor": {
      "maxLength": 4096,
      "type": "string"
    },
    "filter": {
      "additionalProperties": false,
      "properties": {
        "equals": true,
        "field": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "field",
        "equals"
      ],
      "type": "object"
    },
    "limit": {
      "default": 50,
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "schemaName": {
      "minLength": 1,
      "type": "string"
    },
    "site": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "site",
    "schemaName"
  ],
  "title": "Запрос forms.list v1",
  "type": "object"
}
